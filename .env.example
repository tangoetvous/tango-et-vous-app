# Tango & Vous — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Note : ces variables sont actuellement codées en dur dans js/tev-supabase.js
# (clé anon publique — sans danger d'exposer côté client).
# Si vous souhaitez les externaliser via un bundler (Vite, etc.) :

# URL du projet Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anonyme Supabase (publique, safe côté client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL de l'application (pour les redirections magic link)
VITE_APP_URL=https://votre-domaine.vercel.app
